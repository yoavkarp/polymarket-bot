# Required for --copy mode (live trading)
POLYMARKET_PRIVATE_KEY=0x...

# Optional — builder API key for higher rate limits
POLYMARKET_API_KEY=

# Fractional Kelly multiplier (0.1–1.0, default: 0.5)
KELLY_FRACTION=0.5

# Max position size as a fraction of bankroll (0.01 = 1%, default: 0.1 = 10%)
MAX_POSITION_FRAC=0.1

# Starting virtual bankroll for --test mode
TEST_BANKROLL_USD=10000

# How often to poll smart wallet positions (seconds, default: 60)
POLL_INTERVAL_S=60

# How often to re-run wallet discovery and analysis (hours, default: 24)
REFRESH_INTERVAL_H=24
