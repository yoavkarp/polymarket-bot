# Required for --copy mode (live trading)
POLYMARKET_PRIVATE_KEY=0x...

# Optional — builder API key for higher rate limits
POLYMARKET_API_KEY=

# Fractional Kelly multiplier (0.1–1.0, default: 0.5)
KELLY_FRACTION=0.5

# Starting virtual bankroll for --test mode
TEST_BANKROLL_USD=100

# Max fraction of portfolio that can be deployed at once (0.5 = 50%, default: 0.5)
MAX_TOTAL_EXPOSURE=0.5

# Max price drift to still copy a pre-existing smart wallet position on startup (default: 0.02 = 2 cents)
PRICE_MATCH_TOLERANCE=0.02

# How often to poll smart wallet positions (seconds, default: 60)
POLL_INTERVAL_S=60

# How often to re-run wallet discovery and analysis (hours, default: 24)
REFRESH_INTERVAL_H=24

# Port for the REST + SSE API server (default: 3000)
API_PORT=3000